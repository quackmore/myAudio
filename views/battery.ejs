<html>

<head>
  <%- include('./partials/_common_head'); %>
</head>

<body>
  <%- include('./partials/_nav'); %>

    <div>
      <h3>Battery Voltage</h3>
      <canvas id="theChart"></canvas>
    </div>

    <fieldset>
      <legend>Select a timeframe</legend>

      <div>
        <input onchange="batvGraphTF('lastTenDays')" type="radio" id="lastTen" name="since">
        <label for="lastTen">Last 10 days</label>
      </div>
      <div>
        <input onchange="batvGraphTF('since')" type="radio" id="custom" name="since">
        <label for="custom">Since</label>
        <input onchange="batvGraphTF('customDate')" type="date" id="customDate">
      </div>
      <div>
        <input onchange="batvGraphTF('all')" type="radio" id="all" name="since">
        <label for="all">All available data</label>
      </div>
    </fieldset>


    <!-- SCRIPTS-->
    <%- include('./partials/_helpers'); %>
      <%- include('./partials/_chartjs'); %>

        <script>
          const batvGraphTF = (tf) => {
            switch (tf) {
              case 'lastTenDays':
              default:
                document.getElementById('lastTen').checked = true;
                clientPref.set('batteryGraphTf', 'lastTenDays')
                drawBatV(new Date().getTime() - 10 * (3600000 * 24));
                break;
              case 'all':
                document.getElementById('all').checked = true;
                clientPref.set('batteryGraphTf', 'all')
                drawBatV(-1);
                break;
              case 'customDate':
                clientPref.set('batteryCustomDate', new Date(document.getElementById('customDate').value).toISOString().split('T')[0])
              case 'since':
                clientPref.set('batteryGraphTf', 'since')
                document.getElementById('custom').checked = true;
                // if (!document.getElementById('custom').checked) break;
                if (document.getElementById('customDate').value === "") break;
                if ((new Date(document.getElementById('customDate').value).getTime() <= (new Date()).getTime()))
                  drawBatV((new Date(document.getElementById('customDate').value)).getTime());
                break;
            }

          }

          const drawBatV = (since) => {
            let urlTF;
            if (since === -1)
              urlTF = 'all';
            else
              urlTF = `since/${since}`;
            toutFetch('/battery/' + urlTF, 30000)
              .then(response => response.json())
              .then(data => plotBatV(data.map(({ timestamp, value }) => ({ x: +timestamp, y: +value }))))
              .catch(error => alert(error.message));
          }

          const plotBatV = (vals) => {
            let batvChart = Chart.getChart('theChart');
            if (batvChart != undefined) {
              batvChart.destroy();
            }
            batvChart = new Chart('theChart', {
              type: 'scatter',
              data: {
                datasets: [
                  {
                    label: "Battery Voltage",
                    data: vals,
                    pointRadius: 0,
                    showLine: true,
                    steppedLine: true,
                    fill: false,
                    borderColor: "green",
                    backgroundColor: "green",
                    borderWidth: 1
                  }
                ]
              },
              options: {
                responsive: true,
                aspectRatio: (window.matchMedia("(min-width: 600px)").matches ? 2 : 1),
                interaction: {
                  intersect: false,
                  mode: 'nearest',
                  axis: 'xy'
                },
                plugins: {
                  legend: {
                    display: true,
                    position: 'bottom'
                  },
                  zoom: {
                    zoom: {
                      pinch: {
                        enabled: true
                      },
                      wheel: {
                        enabled: true
                      },
                      mode: 'x'
                    },
                    pan: {
                      enabled: true,
                      mode: 'x'
                    },
                  }
                },
                scales: {
                  x: {
                    type: 'time',
                    time: {
                      tooltipFormat: 'DD MMM HH:MM',
                    },
                    ticks: {
                      source: 'auto'
                    }
                  }
                }
              }
            })
          }

          var clientPref = new userPrefs(JSON.parse(`<%-JSON.stringify(prefs)%>`));
          if (clientPref.get('batteryGraphTf') === undefined) clientPref.set('batteryGraphTf', 'lastTenDays');
          if (clientPref.get('batteryCustomDate') === undefined) clientPref.set('batteryCustomDate', '');

          document.getElementById('customDate').value = clientPref.get('batteryCustomDate');
          batvGraphTF(clientPref.get('batteryGraphTf'));

        </script>

</body>

</html>