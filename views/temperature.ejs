<html>

<head>
  <%- include('./partials/_common_head'); %>
</head>

<body>
  <%- include('./partials/_nav'); %>

    <div>
      <h3>Temperature</h3>
      <canvas id="theChart"></canvas>
    </div>

    <fieldset>
      <legend>Select a timeframe</legend>

      <div>
        <input onchange="tempGraphTF('lastTwoDays')" type="radio" id="lastTwo" name="since">
        <label for="lastTwo">Last 2 days</label>
      </div>
      <div>
        <input onchange="tempGraphTF('since')" type="radio" id="custom" name="since">
        <label for="lastTwo">Since</label>
        <input onchange="tempGraphTF('customDate')" type="date" id="customDate">
      </div>
      <div>
        <input onchange="tempGraphTF('all')" type="radio" id="all" name="since">
        <label for="all">All available data</label>
      </div>
    </fieldset>

    <!-- SCRIPTS-->
    <%- include('./partials/_helpers'); %>
      <%- include('./partials/_chartjs'); %>

        <script>
          const tempGraphTF = (tf) => {
            switch (tf) {
              case 'lastTwoDays':
              default:
                document.getElementById('lastTwo').checked = true;
                clientPref.set('tempGraphTf', 'lastTwoDays')
                drawTemp(new Date().getTime() - 2 * (3600000 * 24));
                break;
              case 'all':
                document.getElementById('all').checked = true;
                clientPref.set('tempGraphTf', 'all')
                drawTemp(-1);
                break;
              case 'customDate':
                clientPref.set('tempCustomDate', new Date(document.getElementById('customDate').value).toISOString().split('T')[0])
              case 'since':
                clientPref.set('tempGraphTf', 'since')
                document.getElementById('custom').checked = true;
                if (document.getElementById('customDate').value === "") break;
                if ((new Date(document.getElementById('customDate').value).getTime() <= (new Date()).getTime()))
                  drawTemp((new Date(document.getElementById('customDate').value)).getTime());
                break;
            }
          }

          const getTemp = (url) => {
            return toutFetch(url, 30000)
              .then(response => response.json())
              .then(data => data.map(({ timestamp, value }) => ({ x: +timestamp, y: +value })))
              .catch(error => alert(error.message));
          }

          const drawTemp = (since) => {
            let insideTemp, outsideTemp, avgInsideTemp, avgOutsideTemp;
            let urlTF;
            if (since === -1)
              urlTF = 'all';
            else
              urlTF = `since/${since}`;
            getTemp('/insideTemp/' + urlTF)
              .then(data => insideTemp = data)
              .then(() => getTemp('/outsideTemp/' + urlTF))
              .then(data => outsideTemp = data)
              .then(() => getTemp('/insideTemp/average/' + urlTF))
              .then(data => {
                data[0].x = insideTemp[0].x;
                data.push({ x: insideTemp[insideTemp.length - 1].x, y: data[data.length - 1].y });
                avgInsideTemp = data;
              })
              .then(() => getTemp('/outsideTemp/average/' + urlTF))
              .then(data => {
                data[0].x = outsideTemp[0].x;
                data.push({ x: outsideTemp[outsideTemp.length - 1].x, y: data[data.length - 1].y });
                avgOutsideTemp = data;
              })
              .then(() => plotTemp(insideTemp, outsideTemp, avgInsideTemp, avgOutsideTemp))
              .catch(error => alert(error.message))
          }

          const plotTemp = (inVals, outVals, avgInVals, avgOutVals) => {
            let tempChart = Chart.getChart('theChart');
            if (tempChart != undefined) {
              tempChart.destroy();
            }
            tempChart = new Chart('theChart', {
              type: 'scatter',
              data: {
                datasets: [
                  {
                    label: "Inside",
                    data: inVals,
                    pointRadius: 0,
                    showLine: true,
                    // steppedLine: true,
                    fill: false,
                    cubicInterpolationMode: 'monotone',
                    tension: 0.4,
                    borderColor: "green",
                    backgroundColor: "green",
                    borderWidth: 1,
                    hidden: clientPref.get('tempDataHidden')[0]
                  },
                  {
                    label: "AVG",
                    data: avgInVals,
                    pointRadius: 0,
                    showLine: true,
                    steppedLine: true,
                    stepped: "before",
                    fill: false,
                    borderColor: "green",
                    backgroundColor: "green",
                    borderWidth: 1,
                    hidden: clientPref.get('tempDataHidden')[1]
                  },
                  {
                    label: "Outside",
                    data: outVals,
                    pointRadius: 0,
                    showLine: true,
                    // steppedLine: true,
                    fill: false,
                    cubicInterpolationMode: 'monotone',
                    tension: 0.4,
                    borderColor: "blue",
                    backgroundColor: "blue",
                    borderWidth: 1,
                    hidden: clientPref.get('tempDataHidden')[2]
                  },
                  {
                    label: "AVG",
                    data: avgOutVals,
                    pointRadius: 0,
                    showLine: true,
                    steppedLine: true,
                    stepped: "before",
                    fill: false,
                    borderColor: "blue",
                    backgroundColor: "blue",
                    borderWidth: 1,
                    hidden: clientPref.get('tempDataHidden')[3]
                  }
                ]
              },
              options: {
                responsive: true,
                aspectRatio: (window.matchMedia("(min-width: 600px)").matches ? 2 : 1),
                interaction: {
                  intersect: false,
                  mode: 'nearest',
                  axis: 'xy'
                },
                plugins: {
                  legend: {
                    display: true,
                    position: 'bottom',
                    onClick(e, legendItem) {
                      // get the dataset index
                      const index = legendItem.datasetIndex;
                      // update preferences
                      // alert("dataset index " + index + " was clicked")
                      let dts = clientPref.get('tempDataHidden');
                      dts[index] = dts[index] === false ? true : false;
                      clientPref.set('tempDataHidden', dts);
                      // this table object
                      const ci = this.chart;
                      // show/hide dataset
                      var meta = ci.getDatasetMeta(index);
                      meta.hidden = meta.hidden === null ? !ci.data.datasets[index].hidden : null;
                      // a dataset was hidden or shown... rerender the chart
                      ci.update();
                    }
                  },
                  zoom: {
                    zoom: {
                      pinch: {
                        enabled: true
                      },
                      wheel: {
                        enabled: true
                      },
                      mode: 'x'
                    },
                    pan: {
                      enabled: true,
                      mode: 'x'
                    },
                  }
                },
                scales: {
                  x: {
                    type: 'time',
                    time: {
                      tooltipFormat: 'DD MMM HH:MM',
                    },
                    ticks: {
                      source: 'auto'
                    }
                  }
                }
              }
            })
          }

          var clientPref = new userPrefs(JSON.parse(`<%-JSON.stringify(prefs)%>`));
          if (clientPref.get('tempGraphTf') === undefined) clientPref.set('tempGraphTf', 'lastTwoDays');
          if (clientPref.get('tempCustomDate') === undefined) clientPref.set('tempCustomDate', '');
          if (clientPref.get('tempDataHidden') === undefined) clientPref.set('tempDataHidden', [false, false, false, false]);

          document.getElementById('customDate').value = clientPref.get('tempCustomDate');
          tempGraphTF(clientPref.get('tempGraphTf'));

        </script>

</body>

</html>