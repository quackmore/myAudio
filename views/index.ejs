<!DOCTYPE html>
<html>

<head>
  <%- include('./partials/_common_head'); %>
</head>

<body>
  <div id="spinnerMod" class="overlay">
    <div class="spinner">
    </div>
  </div>

  <div class="upBox">
    <div class="fixedWidth">
      <div class="justify">
        <div class="left">
          <select class="myselect" name="audioSel" id="outSel" onchange="refreshPlayerStatus()">
            <option value="bt">Bluetooth</option>
            <option value="spkrs">Speakers</option>
          </select>
          <div id="outputSelect" onclick="outputSelect()"></div>
          <div class="left" id="btDevDesc" style="font-size: small"></div>
        </div>
      </div>
      <div id="btDevMod" style="display: none;">
        <div id="btDevList" style="padding: 20px; background-color: lightblue;">
          <div class="justify">
            <span>Device 1</span>
            <div class="right">
              <i class="fa-regular fa-trash-can"></i>
            </div>
          </div>
          <div class="justify">
            <span>Device lunghissima</span>
            <span>&emsp;&emsp;</span>
            <div class="right">
              <i class="fa-regular fa-trash-can"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="center" style="padding: 10px;">
        <span id="song" style="font-size: small;">-</span>
      </div>
      <div class="center" style="gap: 10px;">
        <div class="left" style="width: 60%;">
          <input type="range" min="1" max="100" value="0" class="slider" id="elapsed" onchange="setPosition(this.value)"
            onmousedown="setUpdateElapsed(0);" onmouseup="setUpdateElapsed(1000);">
        </div>
        <span class="right" style="font-size: small;" id="duration"> </span>
      </div>
      <div class="justify" style="padding-top: 10px;">
        <div class="justify" style="padding-left: 40px; padding-right: 40px;">
          <i class="fa-solid fa-shuffle fa-xs" style="color: lightgray;" id="shuffle" onclick="toggleShuffle()"></i>
          <i class="fa-solid fa-backward-step fa-sm" id="previous" onclick="mpdCmd('previous',[])"></i>
          <i class="fa-solid fa-play fa-xl" id="play" onclick="togglePlay()"></i>
          <i class="fa-solid fa-forward-step fa-sm" id="next" onclick="mpdCmd('next',[])"></i>
          <i class="fa-solid fa-repeat fa-xs" style="color: lightgray;" id="repeat" onclick="toggleRepeat()"></i>
          <i class="fa-solid fa-1 fa-xs" style="color: lightgray;" id="single" onclick="toggleSingle()"></i>
        </div>
        <div class="right" style="padding-right: 20px;">
          <div class="left">
            <span id="volMute2" onclick="volumeToggleMute()">
              <i class="fa-solid fa-volume-xmark"></i>
            </span>
          </div>
          <div class="right">
            <span id="volLevel" onclick="openVolumeMod()">0</span>
          </div>
        </div>
      </div>
      <div id="volumeMod" style="display: none; margin-top: 10px;">
        <div class="justify">
          <div class="justify" style="padding: 20px; background-color: lightblue;">
            <div class=" left">
              <span id="volMute" onclick="volumeToggleMute()">
                <i class="fa-solid fa-volume-xmark"></i>
              </span>
              <i id="volMinus" class="fa-solid fa-minus" onclick="volumeDec()"></i>
            </div>
            <div class="volSlider">
              <input type="range" min="1" max="100" value="0" class="slider" id="volRange" disabled
                onchange="volumeSet()" oninput="showVolume()">
            </div>
            <div class="right">
              <i id="volPlus" class="fa-solid fa-plus" onclick="volumeInc()"></i>
            </div>
            <div class="right">
              <i onclick="closeVolumeMod()" class="fa-regular fa-xmark"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="lowBox">
    <ul class="noGrowNoShrink tabrow">
      <li onclick="loadQueue()" id="queueTab">Queue</li>
      <li onclick="listPlaylists()" id="playlistsTab">Playlists</li>
      <li onclick="loadFiles()" id="filesTab">Files</li>
      <li onclick="loadStreams()" id="streamsTab">Streams</li>
      <li onclick="loadPodcast()" id="podcastTab">Podcasts</li>
    </ul>
    <div class="center tabCntTitle" id="listTitle" style="display: none;">
      <label>Playlist</label>
      <input type="text" id="plName">
      <i class="fa-solid fa-undo" onclick="plModNameUndo()"></i>
    </div>
    <div class="tabContent" id="tabCt">
    </div>
    <div class="cmdLine" id="plSelCmd" style="display: none;">
      <select class="myselect cmdBtn" name="plSelect" id="plSelect">
        <option value="">new playlist...</option>
      </select>
      <button class="cmdBtn" id="plSelConfirm" onclick="">confirm</button>
      <button class="cmdBtn" onclick="hideSelectPlaylist()">cancel</button>
    </div>
    <div class="cmdLine" id="queueCmds" style="display: none;">
      <button class="cmdBtn" onclick="quAddToPlaylist()">add to playlist</button>
      <button class="cmdBtn" onclick="quPlay()">play</button>
      <button class="cmdBtn" onclick="quRemove()">remove</button>
    </div>
    <div class="cmdLine" id="playlistCmds" style="display: none;">
      <button class="cmdBtn" onclick="plAddToQueue()">add to queue</button>
      <button class="cmdBtn" onclick="plReplQueue()">replace queue</button>
      <button class="cmdBtn" onclick="plModify()">modify</button>
      <button class="cmdBtn" onclick="plRemove()">remove</button>
    </div>
    <div class="cmdLine" id="playlistModifyCmds" style="display: none;">
      <button class="cmdBtn" onclick="plModCancel()">cancel</button>
      <button class="cmdBtn" onclick="plModSave()">save</button>
      <button class="cmdBtn" onclick="plModRemove()">remove</button>
    </div>
    <div class="cmdLine" id="filesCmds" style="display: none;">
      <button class="cmdBtn" onclick="fsAddToPlaylist()">add to playlist</button>
      <button class="cmdBtn" onclick="fsAddToQueue()">add to queue</button>
      <button class="cmdBtn" onclick="fsReplQueue()">replace queue</button>
    </div>
    <div class="cmdLine" id="streamsCmds" style="display: none;">
      <button class=" cmdBtn" onclick="stModify()">modify</button>
      <button class="cmdBtn" onclick="stReplQueue()">play</button>
      <button class="cmdBtn" onclick="stRemove()">remove</button>
    </div>
    <div class="noGrowNoShrink justify" style="height: 50px;">
      <div class="justify" id="queueFn">
        <div class="left" style="font-size: medium;">
          <span id="queueDuration"></span>
        </div>
        <div class="right">
          <button onclick="initLiSelected()" id="cancel1" disabled>cancel</button>
          <button onclick="saveQueue()">save</button>
          <button onclick="clearQueue()">clear</button>
        </div>
      </div>
      <div class="justify" id="playlistsFn" style="display: none;">
        <div class="left" style="font-size: medium;">
        </div>
        <div class="right">
          <button onclick="initLiSelected()" id="cancel2" disabled>cancel</button>
        </div>
      </div>
      <div class="justify" id="filesFn" style="display: none;">
        <div class="left" style="font-size: medium;">
        </div>
        <div class="right">
          <button onclick="initLiSelected()" id="cancel3" disabled>cancel</button>
          <button onclick="goBack()" id="goBack" disabled>back</button>
        </div>
      </div>
      <div class="justify" id="streamsFn" style="display: none;">
        <div class="left" style="font-size: medium;">
        </div>
        <div class="right">
          <button onclick="initLiSelected()" id="cancel4" disabled>cancel</button>
          <button onclick="newStream()">new stream</button>
        </div>
      </div>
    </div>

  </div>

  <!-- SCRIPTS-->
  <%- include('./partials/_helpers'); %>

    <script>

      let inPrefs = JSON.parse(`<%-JSON.stringify(prefs)%>`);

      // PLAYER

      var player = {};

      const outputSelect = async () => {
        let req = "";
        let url = ""
        if (document.getElementById('outSel').value === 'spkrs') {
          req = {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: `{"aux_contacts_status": "${player.speakers.speakerOn === 'on' ? "open" : "closed"}"}`
          };
          url = `http://${player.speakers.contactDevice}/auxContactsStatus?${new URLSearchParams({ "id": player.speakers.contactRelay })}`;
        } else {
          req = {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          };
          url = `/bt/status/power/${player.bt.Powered === 'yes' ? 'off' : 'on'}`;
        }
        try {
          await toutFetch(url, 5000, req);
          refreshPlayerStatus();
        }
        catch (err) {
          alert(err.message);
        }
      }

      let firstTime = true;

      const refreshPlayerStatus = async () => {
        try {
          if (firstTime) {
            await getSpeakerStatus();
            await getBtStatus();
            await getBtDevices();
            await getMpdStatus();
            document.getElementById('outSel').value = 'spkrs';
            if (player.bt.Powered === 'yes') document.getElementById('outSel').value = 'bt';
            firstTime = false;
          }
          if (document.getElementById('outSel').value === 'spkrs') {
            await getSpeakerStatus();
            updateSpeakers();
          } else {
            await getBtStatus();
            await getBtDevices();
            updateBT();
          }
          showBtDevices();
          await getMpdStatus();
          updateMpdPlayer();
          // DEBUG
          // console.log(player);
        }
        catch (err) {
          alert(err.message);
        }
      }

      let refreshInterval = null;
      const periodicRefreshStatus = (val) => {
        clearInterval(refreshInterval);
        refreshInterval = setInterval(refreshPlayerStatus, val);
      }

      // SPEAKERS

      player.speakers = {};
      player.speakers.contactDevice = inPrefs.audioContactDev;
      player.speakers.contactRelay = +inPrefs.audioContactRel;

      const getSpeakerStatus = () => {
        return toutFetch(`http://${player.speakers.contactDevice}/auxContactsStatus`, 5000)
          .then(res => res.json())
          .then(data => player.speakers.speakerOn = (data.aux_contacts_status[player.speakers.contactRelay] === 'closed' ? 'on' : 'off'))
      }

      const updateSpeakers = () => {
        if (!player.speakers) return;
        document.getElementById('outputSelect').innerHTML = (player.speakers.speakerOn === 'on' ? '<i class="fa-solid fa-toggle-on fa-xl"></i>' : '<i class="fa-solid fa-toggle-off fa-xl"></i>');
        document.getElementById('btDevDesc').innerHTML = "";
        document.getElementById('volRange').value = 0;
        document.getElementById('volRange').disabled = true;
        document.getElementById('volLevel').innerText = 0;
        document.getElementById('volMute').innerHTML = '<i class="fa-solid fa-volume-xmark"></i>';
      }

      // MPD PLAYER

      const mpdCmd = (cmd, options) => {
        let req = {
          method: 'POST'
        };
        url = `/mpd/cmd/${cmd}`;
        for (opt of options)
          url += `/${opt}`;
        return toutFetch(url, 5000, req)
          .then(res => res.json())
          .then(() => refreshPlayerStatus())
          .then(() => refreshQueue())
          .catch(err => alert(err.message));
      }

      const getMpdStatus = () => {
        return toutFetch(`/mpd/status`, 5000)
          .then(res => res.json())
          .then(data => player.mpd = data)
      }

      const setPosition = async (perc) => {
        if (player.hasOwnProperty('mpd')
          && player.mpd.hasOwnProperty('curSong')
          && player.mpd.hasOwnProperty('status')
          && !player.mpd.curSong.file.startsWith('http')) {
          setUpdateElapsed(0);
          let duration = parseFloat(player.mpd.status.duration);
          await mpdCmd('seekcur', [duration * perc / 100]);
          setUpdateElapsed(1000);
        }
      }

      const refreshElapsed = async () => {
        if (!player.mpd || !player.mpd.status) return;
        if (!player.mpd.hasOwnProperty('curSong')) return;
        if (player.mpd.curSong.file.startsWith('http')) {
          let elapsed = parseFloat(player.mpd.status.elapsed) + 1.0;
          player.mpd.status.elapsed = elapsed.toString();
          document.getElementById('duration').innerText = `${secsToString(elapsed)}`;
          document.getElementById('elapsed').value = 0;
        } else {
          let elapsed = parseFloat(player.mpd.status.elapsed) + 1.0;
          let duration = parseFloat(player.mpd.status.duration);
          document.getElementById('duration').innerText = `${secsToString(elapsed)} - ${secsToString(duration)}`;
          if (elapsed >= duration) {
            await refreshPlayerStatus();
            refreshQueue();
          } else {
            player.mpd.status.elapsed = elapsed.toString();
            document.getElementById('elapsed').value = 100 * elapsed / duration;
          }
        }
      }

      let updateElapsed = null;
      const setUpdateElapsed = (val) => {
        clearInterval(updateElapsed);
        if (val > 0)
          updateElapsed = setInterval(refreshElapsed, val);
      }

      const toggleShuffle = () => {
        if (!player.mpd) return;
        if (player.mpd.status.random === '1')
          mpdCmd('random', ['0']);
        else
          mpdCmd('random', ['1']);
      }

      const togglePlay = () => {
        if (!player.mpd) return;
        if (player.mpd.status.state === 'play')
          mpdCmd('pause', []);
        else
          mpdCmd('play', []);
      }

      const toggleRepeat = () => {
        if (!player.mpd) return;
        if (player.mpd.status.repeat === '1')
          mpdCmd('repeat', ['0']);
        else
          mpdCmd('repeat', ['1']);
      }

      const toggleSingle = () => {
        if (!player.mpd) return;
        if (player.mpd.status.single === '1')
          mpdCmd('single', ['0']);
        else
          mpdCmd('single', ['1']);
      }

      function playerDefault() {
        document.getElementById('song').innerHTML = "-";
        document.getElementById('duration').innerText = "";
        document.getElementById('elapsed').value = 0;
        document.getElementById('play').className = "fa-solid fa-play fa-xl";
      }

      const updateMpdPlayer = () => {
        if (!player.hasOwnProperty('mpd') || !player.mpd.hasOwnProperty('curSong') || !player.mpd.curSong.hasOwnProperty('file')) {
          playerDefault();
          return;
        }
        if (player.mpd.curSong) {
          let desc = "";
          if (player.mpd.curSong.file.startsWith('http')) {
            if (player.mpd.curSong.hasOwnProperty('Name'))
              desc = `${player.mpd.curSong.Name}`;
            else
              desc = `${player.mpd.curSong.file.replaceAll(',', ':')}`;
          } else {
            if (!player.mpd.curSong.Artist)
              player.mpd.curSong.Artist = player.mpd.curSong.AlbumArtist;
            desc = `${player.mpd.curSong.Artist} - ${player.mpd.curSong.Title} [${player.mpd.curSong.Album}]`;
            if (desc.length > 58)
              desc = `<center>${player.mpd.curSong.Artist}</center>\n<center>${player.mpd.curSong.Title}</center>\n<center>[${player.mpd.curSong.Album}]</center>`;
          }
          document.getElementById('song').innerHTML = desc;
        }
        if (player.mpd.status) {
          if (player.mpd.status.error) alert(player.mpd.status.error);
          //document.getElementById('elapsed').value = 100 * parseFloat(player.mpd.status.elapsed) / parseFloat(player.mpd.status.duration);
          if (player.mpd.status.random === '1')
            document.getElementById('shuffle').style.color = null;
          else
            document.getElementById('shuffle').style.color = 'lightgray';
          if (player.mpd.status.repeat === '1')
            document.getElementById('repeat').style.color = null;
          else
            document.getElementById('repeat').style.color = 'lightgray';
          if (player.mpd.status.single === '1')
            document.getElementById('single').style.color = null;
          else
            document.getElementById('single').style.color = 'lightgray';
          if (player.mpd.status.state === 'play') {
            document.getElementById('play').className = "fa-solid fa-pause fa-xl";
            refreshElapsed();
            setUpdateElapsed(1000);
          } else {
            document.getElementById('play').className = "fa-solid fa-play fa-xl";
            setUpdateElapsed(0);
          }
        }
      }

      // BLUETOOTH

      const getBtStatus = () => {
        return toutFetch(`/bt/status`, 5000)
          .then(res => res.json())
          .then(data => player.bt = data)
      }

      const getBtDevices = () => {
        return toutFetch(`/bt/devices`, 5000)
          .then(res => res.json())
          .then(data => player.bt.devices = data)
      }

      const showBtDevices = () => {
        if (document.getElementById('outSel').value === 'spkrs') {
          closeBtDevMod();
        }
        else {
          if (player.bt.Powered !== 'yes') closeBtDevMod();
        }
      }

      const connectDev = async (idx) => {
        loadSpinner();
        toutFetch(`/bt/device/connect/${player.bt.devices[idx].address}`, 60000, {
          method: 'POST'
        })
          .then(() => {
            // closeBtDevMod();
            refreshPlayerStatus();
          })
          .catch((err) => alert(`Failed to connect to ${player.bt.devices[idx].name}: ${err.message}`))
          .finally(() => unloadSpinner());
      }

      const deleteDev = async (idx) => {
        toutFetch(`/bt/device/remove/${player.bt.devices[idx].address}`, 60000, {
          method: 'POST'
        })
          .then(() => refreshPlayerStatus())
          .catch((err) => alert(`Failed to remove ${player.bt.devices[idx].name}: ${err.message}`));
      }

      const devOnline = (idx) => {
        if (player.bt.devices[idx].online)
          return player.bt.devices[idx].online === "yes" ? "[online]" : "";
        return "";
      }

      const findBTconnectedDev = async () => {
        for (dev of player.bt.devices)
          if (dev.connected === "yes" && dev.volCtrl) return dev;
        return {};
      }

      const openBtDevMod = () => {
        if (document.getElementById("btDevMod").style.display === "block") return;
        document.getElementById("btDevMod").style.display = "block";
        periodicRefreshStatus(3000);
        if (player.bt.Powered === 'yes') {
          toutFetch('/bt/status/scan/on', 5000, {
            method: 'POST'
          })
            // .then(() => refreshPlayerStatus())
            .catch((err) => alert(err.message));
        }
      }

      const closeBtDevMod = () => {
        if (document.getElementById("btDevMod").style.display === "none") return;
        setTimeout(periodicRefreshStatus, 20000, 30000);
        document.getElementById("btDevMod").style.display = "none";
        if (player.bt.Powered === 'yes') {
          toutFetch('/bt/status/scan/off', 5000, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          })
            .then(() => refreshPlayerStatus())
            .catch((err) => alert(err.message));
        }
      }

      const updateBT = () => {
        if (!player.bt) return;
        document.getElementById('outputSelect').innerHTML = (player.bt.Powered === 'yes' ? '<i class="fa-solid fa-toggle-on fa-xl"></i>' : '<i class="fa-solid fa-toggle-off fa-xl"></i>');
        let btDevList = document.getElementById('btDevList');
        btDevList.innerHTML = "";
        let connectedDev = -1;
        for (let [idx, dev] of player.bt.devices.entries()) {
          if (dev.connected === 'yes') connectedDev = idx;
          btDevList.innerHTML += `<div class="justify"><span onclick="connectDev(${idx})">${dev.name}</span><span>&emsp;&emsp;</span><span class="right">${devOnline(idx)}</span><span class="right"><i class="fa-regular fa-trash-can" onclick="deleteDev(${idx})"></i></span>`;
        }
        if (connectedDev >= 0) {
          closeBtDevMod();
          document.getElementById('btDevDesc').innerHTML = `<span>${player.bt.devices[connectedDev].name}</span><i class="fa-regular fa-battery-three-quarters"></i><span>${player.bt.devices[connectedDev].battery ? player.bt.devices[connectedDev].battery : ""}</span>`;
          if (player.bt.devices[connectedDev].volume) {
            document.getElementById('volRange').value = player.bt.devices[connectedDev].volume.split("%")[0];
            document.getElementById('volLevel').innerText = player.bt.devices[connectedDev].volume.split("%")[0];
            document.getElementById('volRange').disabled = false;
          }
          if (player.bt.devices[connectedDev].mute) {
            document.getElementById('volMute').innerHTML = player.bt.devices[connectedDev].mute === "yes" ? '<i class="fa-solid fa-volume-xmark"></i>' : '<i class="fa-solid fa-volume-high"></i>';
            document.getElementById('volMute2').innerHTML = player.bt.devices[connectedDev].mute === "yes" ? '<i class="fa-solid fa-volume-xmark"></i>' : '<i class="fa-solid fa-volume-high"></i>';
          }
        }
        else {
          if (player.bt.Powered === 'yes') openBtDevMod();
          document.getElementById('btDevDesc').innerHTML = "";
          document.getElementById('volRange').value = 0;
          document.getElementById('volRange').disabled = true;
          document.getElementById('volLevel').innerText = 0;
          document.getElementById('volMute').innerHTML = '<i class="fa-solid fa-volume-xmark"></i>';
          document.getElementById('volMute2').innerHTML = '<i class="fa-solid fa-volume-xmark"></i>';
        }
      }

      // VOLUME

      const volumeSet = async () => {
        if (document.getElementById('outSel').value === 'spkrs') {
          return;
        } else {
          let dev = await findBTconnectedDev();
          if (Object.keys(dev).length === 0) return;
          let vol = document.getElementById('volRange').value;
          if (`${vol}%` !== dev.volume)
            toutFetch(`/bt/volume/set/${dev.address}/${vol}%25`, 60000, {
              method: 'POST'
            })
              .then(() => refreshPlayerStatus())
              .catch((err) => alert(`Failed to set ${dev.name} volume to ${vol} - ${err.message}`));
        }
      }

      const showVolume = () => {
        if (document.getElementById('outSel').value === 'spkrs') {
          return;
        } else {
          document.getElementById('volLevel').innerText = document.getElementById('volRange').value;
        }
      }

      const volumeInc = async () => {
        if (document.getElementById('volRange').disabled) return;
        if (document.getElementById('outSel').value === 'spkrs') {
          return;
        } else {
          let dev = await findBTconnectedDev();
          if (Object.keys(dev).length === 0) return;
          toutFetch(`/bt/volume/inc/${dev.address}`, 60000, {
            method: 'POST'
          })
            .then(() => refreshPlayerStatus())
            .catch((err) => alert(`Failed to increment ${dev.name} volume - ${err.message}`));
        }
      }

      const volumeDec = async () => {
        if (document.getElementById('volRange').disabled) return;
        if (document.getElementById('outSel').value === 'spkrs') {
          return;
        } else {
          let dev = await findBTconnectedDev();
          if (Object.keys(dev).length === 0) return;
          toutFetch(`/bt/volume/dec/${dev.address}`, 60000, {
            method: 'POST'
          })
            .then(() => refreshPlayerStatus())
            .catch((err) => alert(`Failed to increment ${dev.name} volume - ${err.message}`));
        }
      }

      const volumeToggleMute = async () => {
        if (document.getElementById('outSel').value === 'spkrs') {
          return;
        } else {
          let dev = await findBTconnectedDev();
          if (Object.keys(dev).length === 0) return;
          if (dev.mute)
            toutFetch(`/bt/volume/set/${dev.address}/${dev.mute === "yes" ? "unmute" : "mute"}`, 60000, {
              method: 'POST'
            })
              .then(() => refreshPlayerStatus())
              .catch((err) => alert(`Failed to set ${dev.name} volume to ${vol} - ${err.message}`));
        }
      }

      const openVolumeMod = () => {
        if (document.getElementById("volumeMod").style.display !== "block") {
          document.getElementById("volumeMod").style.display = "block";
        } else {
          closeVolumeMod();
        }
      }

      const closeVolumeMod = () => {
        document.getElementById("volumeMod").style.display = "none";
      }

      // CONTENT TAB

      var selectedTab = null;

      function selectTab(tab) {
        hidelistTitle();
        if (selectedTab) selectedTab.classList.remove("selected");
        selectedTab = document.getElementById(tab);
        selectedTab.classList.add("selected");
      }

      // CONTENT FOOTNOTE

      var selectedFN = null;

      function selectFN(name) {
        if (selectedFN) selectedFN.style.display = "none";
        selectedFN = document.getElementById(name);
        selectedFN.style.display = "flex";
      }

      // CONTENT SELECTION
      var selectedCmds = null;

      function selectCmds(name) {
        if (selectedCmds) selectedCmds.style.display = "none";
        selectedCmds = document.getElementById(name);
        initLiSelected();
      }

      function showCmds() {
        if (selectedCmds) selectedCmds.style.display = "flex";
        document.getElementById("cancel1").disabled = false;
        document.getElementById("cancel2").disabled = false;
        document.getElementById("cancel3").disabled = false;
        document.getElementById("cancel4").disabled = false;
      }

      function hideCmds() {
        if (selectedCmds) selectedCmds.style.display = "none";
        document.getElementById("cancel1").disabled = true;
        document.getElementById("cancel2").disabled = true;
        document.getElementById("cancel3").disabled = true;
        document.getElementById("cancel4").disabled = true;
      }

      var liSelected = [];
      var multipleliSelect = false;

      let liSelectTimeout = null;

      function initLiSelected() {
        multipleliSelect = false;
        for (item of liSelected) {
          if (document.getElementById(`li_${item}`))
            document.getElementById(`li_${item}`).style.backgroundColor = "transparent";
        }
        liSelected = [];
        hideCmds();
      }

      function liSelectMultiple() {
        multipleliSelect = true;
        for (item of liSelected) {
          document.getElementById(`li_${item}`).style.backgroundColor = "lightskyblue";
        }
      }

      const limu = (val) => {
        clearTimeout(liSelectTimeout);
      }

      function limd(idx) {
        if (multipleliSelect) {
          if (liSelected.includes(idx)) {
            liSelected.splice(liSelected.indexOf(idx), 1);
            document.getElementById(`li_${idx}`).style.backgroundColor = "transparent";
            if (liSelected.length === 0) hideCmds();
          } else {
            if (liSelected.length === 0) showCmds();
            liSelected.push(idx);
            document.getElementById(`li_${idx}`).style.backgroundColor = "lightskyblue";
          }
        } else {
          showCmds();
          for (item of liSelected) {
            document.getElementById(`li_${item}`).style.backgroundColor = "transparent";
          }
          liSelected = [];
          liSelected.push(idx);
          document.getElementById(`li_${idx}`).style.backgroundColor = "lightblue";
          liSelectTimeout = setTimeout(liSelectMultiple, 1000);
        }
        // DEBUG
        // console.log(liSelected);
      }

      function showSelectPlaylist(onConfirm) {
        document.getElementById("plSelCmd").style.display = "flex";
        document.getElementById("plSelConfirm").onclick = onConfirm;
        toutFetch(`/mpd/listinfo/listplaylists`, 5000)
          .then(data => data.json())
          .then(data => {
            document.getElementById("plSelect").innerHTML = "<option value=''>new playlist...</option>";
            data
              .sort((a, b) => {
                if (a.playlist < b.playlist) return -1;
                if (a.playlist > b.playlist) return 1;
                return 0;
              })
              .map(el => document.getElementById("plSelect").innerHTML += `<option value="${el.playlist}">${el.playlist}</option>`);
          })
          .catch(err => alert(err.message));
      }

      function hideSelectPlaylist() {
        document.getElementById("plSelCmd").style.display = "none";
      }

      function showListTitle() {
        document.getElementById("listTitle").style.display = "flex";
      }

      function hidelistTitle() {
        document.getElementById("listTitle").style.display = "none";
      }
      // QUEUE

      var queue = {};

      function getQueueDes(item) {
        let res = { desc: "", style: "", playing: "" };
        if (item.file.startsWith('http')) {
          if (item.hasOwnProperty('Name'))
            res.desc = `${item.Name} - <small><i>${item.file.replaceAll(',', ':')}</i></small>`;
          else
            res.desc = `${item.file.replaceAll(',', ':')}`;
        } else {
          if (!item.hasOwnProperty('Artist')) item.Artist = item.AlbumArtist;
          res.desc = `${item.Artist} - ${item.Album} - ${item.Title}`;
        }
        if (player.mpd.hasOwnProperty('curSong') &&
          player.mpd.curSong.file === item.file) {
          res.style = 'style="color: blue; "';
          if (player.mpd.status.state === "play")
            res.playing += '&nbsp&nbsp&nbsp&nbsp<i class="fa-solid fa-music fa-2xs"></i>';
        }
        return res;
      }

      const loadQueue = async () => {
        loadSpinner();
        selectTab("queueTab");
        selectFN("queueFn");
        selectCmds("queueCmds");
        toutFetch(`/mpd/listinfo/playlistinfo`, 5000)
          .then(data => data.json())
          .then(data => {
            queue.songs = data;
            queue.duration = 0.0;
            if (queue.songs.length) {
              let pl_content = '<ul class="tabCntList">';
              for ([idx, item] of queue.songs.entries()) {
                if (parseFloat(item.duration))
                  queue.duration += parseFloat(item.duration);
                let qline = getQueueDes(item);
                pl_content += `<li class="tabCntLine" onmousedown="limd(${idx})" onmouseup="limu(${idx})" id="li_${idx}" ${qline.style}>${qline.desc}${qline.playing}</li>`;
              }
              // DEBUG
              // console.log(queue);
              pl_content += "</ul>";
              document.getElementById("tabCt").innerHTML = pl_content;
              if (queue.songs[0].file.startsWith('http'))
                document.getElementById("queueDuration").innerText = '';
              else
                document.getElementById("queueDuration").innerText = secsToString(queue.duration);
            } else {
              document.getElementById("tabCt").innerHTML = '<ul class="tabCntList"><li>Empty.</li></ul>';
              document.getElementById("queueDuration").innerText = "";

            }
          })
          .catch(err => alert(err.message))
          .finally(() => unloadSpinner());

      }

      const clearQueue = () => {
        if (queue.hasOwnProperty('songs') && queue.songs.length > 0) {
          let text = "This is gonna clear the queue...";
          if (confirm(text) == true) {
            mpdCmd('clear', []);
          }
        }
      }

      const refreshQueue = () => {
        if (document.getElementById("queueTab").classList.contains("selected")) loadQueue();
      }

      function saveQueue() {
        let name = prompt("Enter playlist name");
        if (name != null)
          mpdCmd('save', [name]);
      }

      function quRemove() {
        liSelected.map(el => mpdCmd('deleteid', [queue.songs[el].Id]));
      }

      function quPlay() {
        mpdCmd('play', [queue.songs[liSelected[0]].Pos]);
      }

      // PLAYLISTS

      var playlists = {};

      const listPlaylists = async () => {
        selectTab("playlistsTab");
        selectFN("playlistsFn");
        selectCmds("playlistCmds");
        toutFetch(`/mpd/listinfo/listplaylists`, 5000)
          .then(data => data.json())
          .then(data => {
            playlists = data.sort((a, b) => {
              if (a.playlist < b.playlist) return -1;
              if (a.playlist > b.playlist) return 1;
              return 0;
            });
            if (playlists.length) {
              let pl_content = '<ul class="tabCntList">';
              for ([idx, item] of playlists.entries())
                pl_content += `<li class="tabCntLine" onmousedown="limd(${idx})" onmouseup="limu(${idx})" id="li_${idx}">${item.playlist}</li>`;
              pl_content += "</ul>";
              document.getElementById("tabCt").innerHTML = pl_content;
            } else
              document.getElementById("tabCt").innerHTML = '<ul class="tabCntList"><li>Empty.</li></ul>';
          })
          .catch(err => alert(err.message));
      }

      function plReplQueue() {
        mpdCmd('clear', [])
          .then(() => liSelected.map(el => mpdCmd('load', [playlists[el].playlist])))
          .catch(err => alert(err.message))
          .finally(() => initLiSelected());
      }

      function plAddToQueue() {
        liSelected.map(el => mpdCmd('load', [encodeURIComponent(playlists[el].playlist)]));
        initLiSelected();
      }

      var plModName = "";
      var playlistSongs = {};

      function showPlaylistContent() {
        if (playlistSongs.length) {
          let pl_content = '<ul class="tabCntList">';
          playlistSongs.map((el, idx) => pl_content += `<li class="tabCntLine" onmousedown="limd(${idx})" onmouseup="limu(${idx})" id="li_${idx}">${el.file}</li>`)
          pl_content += "</ul>";
          document.getElementById("tabCt").innerHTML = pl_content;
        } else
          document.getElementById("tabCt").innerHTML = '<ul class="tabCntList"><li>Empty.</li></ul>';
      }

      function plModify() {
        plModName = playlists[liSelected[0]].playlist;
        selectCmds("playlistModifyCmds");
        showCmds();
        document.getElementById("plName").value = plModName;
        showListTitle();
        toutFetch(`/mpd/listinfo/listplaylist/${encodeURIComponent(plModName)}`, 5000)
          .then(data => data.json())
          .then(data => {
            playlistSongs = data;
            showPlaylistContent();
          })
          .catch(err => alert(err.message));
      }

      function plModNameUndo() {
        document.getElementById("plName").value = plModName;
      }

      function plModCancel() {
        hidelistTitle();
        listPlaylists();
      }

      async function plModSave() {
        try {
          await mpdCmd("rm", [encodeURIComponent(plModName)]);
          await playlistSongs.map(el => mpdCmd("playlistadd", [
            encodeURIComponent(document.getElementById("plName").value),
            encodeURIComponent(el.file)]));
          listPlaylists();
        }
        catch (err) {
          alert(err.message)
        };
      }

      function plModRemove() {
        liSelected.reverse();
        liSelected.map(el => playlistSongs.splice(el, 1));
        showPlaylistContent();
      }

      function plRemove() {
        liSelected.map(el => mpdCmd('rm', [playlists[el].playlist]));
        listPlaylists();
      }

      function quAddToPlaylist() {
        showSelectPlaylist(quAddToPlaylistConfirm);
      }

      function quAddToPlaylistConfirm() {
        let name = document.getElementById("plSelect").value;
        if (name === '')
          name = prompt("Enter playlist name");
        if (name != null)
          liSelected.map(el => mpdCmd('playlistadd', [name, encodeURIComponent(queue.songs[el].file)]));
        hideSelectPlaylist();
      }

      // FILES

      var files = {};
      var curPath = "";
      var prevPath = [];

      const musicExts = ['mp3', 'mp4', 'm4a', 'flac', 'wav', 'wma', 'aac', 'ogg', 'aiff'];

      const loadFiles = async () => {
        selectTab("filesTab");
        selectFN("filesFn");
        selectCmds("filesCmds");
        let url = "/mpd/listinfo/listfiles" + curPath;
        toutFetch(`/mpd/listinfo/listfiles/${encodeURIComponent(curPath)}`, 5000)
          .then(data => data.json())
          .then(data => data.filter((el) => {
            if (el.directory) return true;
            if (el.file) return musicExts.includes(el.file.split('.').pop())
          }))
          .then((data) => {
            files = data;
            if (files.length) {
              let pl_content = '<ul class="tabCntList">';
              for ([idx, item] of files.entries()) {
                if (item.directory)
                  pl_content += `<li class="tabCntLine" onmousedown="limd(${idx})" onmouseup="limu(${idx})" id="li_${idx}"><button onclick="enterDir('${item.directory}')">${item.directory}</button></li>`;
                if (item.file)
                  pl_content += `<li class="tabCntLine" onmousedown="limd(${idx})" onmouseup="limu(${idx})" id="li_${idx}">${item.file}</li>`;
              }
              pl_content += "</ul>";
              document.getElementById("tabCt").innerHTML = pl_content;
            } else
              document.getElementById("tabCt").innerHTML = '<ul class="tabCntList"><li>Empty.</li></ul>';
          })
          .catch(err => alert(err.message));
      }

      function enterDir(directory) {
        prevPath.push(curPath);
        document.getElementById("goBack").disabled = false;
        if (curPath === "")
          curPath += directory;
        else
          curPath += `/${directory}`;
        loadFiles();
      }

      function goBack() {
        if (prevPath.length === 0) return;
        curPath = prevPath.pop();
        if (prevPath.length === 0) document.getElementById("goBack").disabled = true;
        loadFiles();
      }

      function fsReplQueue() {
        mpdCmd('clear', [])
          .then(() => liSelected.map(el => mpdCmd('add', [encodeURIComponent((curPath === "" ? curPath : curPath + '/') + (files[el].directory ? files[el].directory : files[el].file))])))
          .catch(err => alert(err.message))
          .finally(() => initLiSelected());
      }

      function fsAddToQueue() {
        liSelected.map(el => mpdCmd('add', [encodeURIComponent((curPath === "" ? curPath : curPath + '/') + (files[el].directory ? files[el].directory : files[el].file))]));
        initLiSelected();
      }

      function fsAddToPlaylist() {
        showSelectPlaylist(fsAddToPlaylistConfirm);
      }

      function fsAddToPlaylistConfirm() {
        let name = document.getElementById("plSelect").value;
        if (name === '')
          name = prompt("Enter playlist name");
        if (name != null)
          liSelected.map(el => mpdCmd('playlistadd', [name, encodeURIComponent((curPath === "" ? curPath : curPath + '/') + (files[el].directory ? files[el].directory : files[el].file))]));
        hideSelectPlaylist();
      }

      // STREAMS

      var streams = {};

      const loadStreams = async () => {
        selectTab("streamsTab");
        selectFN("streamsFn");
        selectCmds("streamsCmds");
        toutFetch(`/stream`, 5000)
          .then(data => data.json())
          .then(data => {
            streams = data.sort((a, b) => {
              if (a.name < b.name) return -1;
              if (a.name > b.name) return 1;
              return 0;
            });;
            if (streams.length) {
              let pl_content = '<ul class="tabCntList">';
              for ([idx, item] of streams.entries())
                pl_content += `<li class="tabCntLine" onmousedown="limd(${idx})" onmouseup="limu(${idx})" id="li_${idx}">${item.name} - <small><i>${item.location}</i></small></li>`;
              pl_content += "</ul>";
              document.getElementById("tabCt").innerHTML = pl_content;
            } else
              document.getElementById("tabCt").innerHTML = '<ul class="tabCntList"><li>Empty.</li></ul>';
          })
          .catch(err => alert(err.message));
      }

      function newStream() {
        alert("not implemented");
      }

      function stReplQueue() {
        let req = {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: `{"playlist": "#EXTM3U\\n\\n#EXTALB: ${streams[liSelected[0]].name}\\n#EXTINF:111, ${streams[liSelected[0]].name}\\n${streams[liSelected[0]].location}\\n"}`
        };
        mpdCmd('clear', [])
          .then(() => toutFetch(`/stream/createStreamingPlaylist`, 5000, req))
          .then(() => mpdCmd('load', ['streaming']))
          .then(() => mpdCmd('play', []))
          .then(() => toutFetch(`/stream/deleteStreamingPlaylist`, 5000, { method: 'POST' }))
          .catch(err => alert(err.message))
          .finally(() => initLiSelected());
      }

      function stModify() {
        alert("not implemented");
      }

      function stRemove() {
        alert("not implemented");
      }

      // STARTUP
      async function startup() {
        await refreshPlayerStatus();
        loadQueue();
        periodicRefreshStatus(30000);
      }

      startup();
    </script>


</body>

</html>