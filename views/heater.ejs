<html>

<head>
  <%- include('./partials/_common_head'); %>
</head>

<body>
  <%- include('./partials/_nav'); %>

    <div>
      <h3>Heater</h3>
      <canvas id="theChart"></canvas>
    </div>

    <fieldset>
      <legend>Select a timeframe</legend>

      <div>
        <input onchange="tstGraphTF('lastTwoDays')" type="radio" id="lastTwo" name="since">
        <label for="lastTwo">Last 2 days</label>
      </div>
      <div>
        <input onchange="tstGraphTF('since')" type="radio" id="custom" name="since">
        <label for="lastTwo">Since</label>
        <input onchange="tstGraphTF('customDate')" type="date" id="customDate">
      </div>
      <div>
        <input onchange="tstGraphTF('all')" type="radio" id="all" name="since">
        <label for="all">All available data</label>
      </div>
    </fieldset>

    <!-- SCRIPTS-->
    <%- include('./partials/_helpers'); %>
      <%- include('./partials/_chartjs'); %>

        <script>
          const tstGraphTF = (tf) => {
            switch (tf) {
              case 'lastTwoDays':
              default:
                document.getElementById('lastTwo').checked = true;
                clientPref.set('tstGraphTf', 'lastTwoDays')
                drawTst(new Date().getTime() - 2 * (3600000 * 24));
                break;
              case 'all':
                document.getElementById('all').checked = true;
                clientPref.set('tstGraphTf', 'all')
                drawTst(-1);
                break;
              case 'customDate':
                clientPref.set('tstCustomDate', new Date(document.getElementById('customDate').value).toISOString().split('T')[0])
              case 'since':
                clientPref.set('tstGraphTf', 'since')
                document.getElementById('custom').checked = true;
                if (document.getElementById('customDate').value === "") break;
                if ((new Date(document.getElementById('customDate').value).getTime() <= (new Date()).getTime()))
                  drawTst((new Date(document.getElementById('customDate').value)).getTime());
                break;
            }
          }

          const getTst = (url) => {
            return toutFetch(url, 30000)
              .then(response => response.json())
              .then(data => data.map(({ timestamp, value }) => ({ x: +timestamp, y: +value })))
              .catch(error => alert(error.message));
          }

          const calcHeaterMin = (data, start, end) => {
            // calc how many minutes the heater was on for each day
            let res = [];
            if (data.length < 1) {
              // no data for heater
              res.push({ x: start, y: 0 });
              res.push({ x: end, y: 0 });
              return res;
            }
            // next day from start (at 00:00)
            let nextDayFromStart = new Date(new Date(start).getFullYear(), new Date(start).getMonth(), new Date(start).getDate()).getTime() + 86400000;
            let dataIdx = 0;
            let xVal = start;
            let todayMin = 0;
            if (data[dataIdx].x > nextDayFromStart) {
              // push a zero value at start
              res.push({ x: start, y: 0 });
              // update xVal
              xVal = data[dataIdx].x;
            }
            // next day from first data avaialble (at 00:00)
            let nextX = new Date(new Date(data[dataIdx].x).getFullYear(), new Date(data[dataIdx].x).getMonth(), new Date(data[dataIdx].x).getDate()).getTime() + 86400000;
            while (1) {
              dataIdx++;
              if (dataIdx > (data.length - 1)) {
                // end of data
                // add last array element and return
                res.push({ x: xVal, y: todayMin });
                if (nextX < end) {
                  res.push({ x: nextX, y: 0 });
                  // extend heater on minutes to match inside temp length
                  res.push({ x: end, y: 0 });
                } else {
                  // extend heater on minutes to match inside temp length}
                  res.push({ x: end, y: todayMin });
                }
                return res;
              } else {
                if (data[dataIdx].x >= nextX) {
                  // next element belongs to next day
                  // add an array element for today
                  if (data[dataIdx].y === 0) {
                    if (dataIdx > 0) {
                      let lastHeaterOn = (dataIdx > 0 ? data[dataIdx - 1].x : xVal);
                      todayMin += (nextX - lastHeaterOn) / 60000;
                    }
                  }
                  res.push({ x: xVal, y: todayMin });
                  xVal = nextX;
                  // next day
                  nextX = nextX + 86400000;
                  todayMin = 0;
                  dataIdx--;
                } else {
                  // sum to today minutes
                  if (data[dataIdx].y === 0) {
                    if (dataIdx > 0) {
                      let lastHeaterOn = (dataIdx > 0 ? data[dataIdx - 1].x : xVal);
                      todayMin += (data[dataIdx].x - lastHeaterOn) / 60000;
                    }
                  }
                }
              }
            }
          }

          const drawTst = (since) => {
            let insideTemp, insideTempSP, insideHeater, heaterSt, heaterMin, lowTemp, lowSP, heaterOffset;
            let urlTF;
            if (since === -1)
              urlTF = 'all';
            else
              urlTF = `since/${since}`;
            getTst('/insideTemp/' + urlTF)
              .then(data => insideTemp = data)
              .then(() => getTst('/insideTempSetpoint/' + urlTF))
              .then(data => {
                // extend sp data to inside temp length
                if (data.length > 0)
                  data.push({ x: insideTemp[insideTemp.length - 1].x, y: data[data.length - 1].y });
                insideTempSP = data;
              })
              .then(() => {
                // calc min inside temp for setting heater on/off offset
                lowTemp = insideTemp.reduce((previous, current) => {
                  return current.y < previous.y ? current : previous;
                });
              })
              .then(() => {
                // calc min temp sp for setting heater on/off offset
                if (insideTempSP.length > 0)
                  lowSP = insideTempSP.reduce((previous, current) => {
                    return current.y < previous.y ? current : previous;
                  });
                else
                  lowSP = lowTemp;
              })
              .then(() => {
                // calc heater on/off offset
                if (lowTemp.y <= lowSP.y)
                  heaterOffset = lowTemp.y - 2;
                else
                  heaterOffset = lowSP.y - 2;
              })
              .then(() => getTst('/insideHeater/' + urlTF))
              .then(data => insideHeater = data)
              .then(() => heaterMin = calcHeaterMin(insideHeater, insideTemp[0].x, insideTemp[insideTemp.length - 1].x))
              // extend and offset heater on/off curve
              .then(() => {
                if (insideHeater.length > 0 && (insideHeater[insideHeater.length - 1].x < insideTemp[insideTemp.length - 1].x)) {
                  insideHeater.push({ x: insideTemp[insideTemp.length - 1].x, y: insideHeater[insideHeater.length - 1].y });
                }
                if (insideHeater.length > 0)
                  heaterSt = insideHeater.map(({ x, y }) => ({ x: x, y: y + heaterOffset }));
              })
              .then(() => {
                if (insideHeater.length > 0)
                  heaterSt.unshift({ x: insideTemp[0].x, y: heaterOffset });
              })
              .then(() => plotTst(insideTemp, insideTempSP, heaterSt, heaterMin))
              .catch(error => alert(error.message))
          }

          const plotTst = (insideTemp, insideTempSP, heaterSt, heaterMin) => {
            let tstChart = Chart.getChart('theChart');
            if (tstChart != undefined) {
              tstChart.destroy();
            }
            tstChart = new Chart('theChart', {
              type: 'scatter',
              data: {
                datasets: [
                  {
                    label: "Temperature",
                    data: insideTemp,
                    pointRadius: 0,
                    showLine: true,
                    steppedLine: true,
                    fill: false,
                    borderColor: "green",
                    backgroundColor: "green",
                    borderWidth: 1,
                    yAxisID: 'y_left',
                    hidden: clientPref.get('tstDataHidden')[0]
                  },
                  {
                    label: "Set Point",
                    data: insideTempSP,
                    pointRadius: 0,
                    showLine: true,
                    steppedLine: true,
                    stepped: "before",
                    fill: false,
                    borderColor: "red",
                    backgroundColor: "red",
                    borderWidth: 1,
                    yAxisID: 'y_left',
                    hidden: clientPref.get('tstDataHidden')[1]
                  },
                  {
                    label: "Heater",
                    data: heaterSt,
                    pointRadius: 0,
                    showLine: true,
                    steppedLine: true,
                    stepped: "before",
                    fill: false,
                    borderColor: "black",
                    backgroundColor: "black",
                    borderWidth: 1,
                    yAxisID: 'y_left',
                    hidden: clientPref.get('tstDataHidden')[2]
                  },
                  {
                    label: "Minutes",
                    data: heaterMin,
                    pointRadius: 0,
                    showLine: true,
                    steppedLine: true,
                    stepped: "before",
                    fill: false,
                    borderColor: "blue",
                    backgroundColor: "blue",
                    borderWidth: 1,
                    yAxisID: 'y_right',
                    hidden: clientPref.get('tstDataHidden')[3]
                  }
                ]
              },
              options: {
                responsive: true,
                aspectRatio: (window.matchMedia("(min-width: 600px)").matches ? 2 : 1),
                interaction: {
                  intersect: false,
                  mode: 'nearest',
                  axis: 'xy'
                },
                plugins: {
                  legend: {
                    display: true,
                    position: 'bottom',
                    onClick(e, legendItem) {
                      // get the dataset index
                      const index = legendItem.datasetIndex;
                      // update preferences
                      // alert("dataset index " + index + " was clicked")
                      let dts = clientPref.get('tstDataHidden');
                      dts[index] = dts[index] === false ? true : false;
                      clientPref.set('tstDataHidden', dts);
                      // this table object
                      const ci = this.chart;
                      // show/hide dataset
                      var meta = ci.getDatasetMeta(index);
                      meta.hidden = meta.hidden === null ? !ci.data.datasets[index].hidden : null;
                      // a dataset was hidden or shown... rerender the chart
                      ci.update();
                    }
                  },
                  zoom: {
                    zoom: {
                      pinch: {
                        enabled: true
                      },
                      wheel: {
                        enabled: true
                      },
                      mode: 'x'
                    },
                    pan: {
                      enabled: true,
                      mode: 'x'
                    },
                  }
                },
                scales: {
                  x: {
                    type: 'time',
                    time: {
                      tooltipFormat: 'DD MMM HH:MM',
                    },
                    ticks: {
                      source: 'auto'
                    }
                  },
                  y_left: {
                    type: 'linear',
                    display: true,
                    position: 'left',
                  },
                  y_right: {
                    type: 'linear',
                    display: true,
                    position: 'right'
                  }
                }
              }
            })
          }

          var clientPref = new userPrefs(JSON.parse(`<%-JSON.stringify(prefs)%>`));
          if (clientPref.get('tstGraphTf') === undefined) clientPref.set('tstGraphTf', 'lastTwoDays');
          if (clientPref.get('tstCustomDate') === undefined) clientPref.set('tstCustomDate', '');
          if (clientPref.get('tstDataHidden') === undefined) clientPref.set('tstDataHidden', [false, false, false, false]);

          document.getElementById('customDate').value = clientPref.get('tstCustomDate');
          tstGraphTF(clientPref.get('tstGraphTf'));
        </script>

</body>

</html>